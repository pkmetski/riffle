root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 160
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_import-ordering = enabled
# Disable wrapping rules that conflict with the existing iosMain DAO style.
ktlint_standard_function-signature = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

# The iosMain DAO implementations use compact SQL binding lambdas and dense call chains.
# Disable wrapping rules that conflict with the existing style.
[**/iosMain/**/*.kt]
ktlint_standard_statement-wrapping = disabled
ktlint_standard_wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_brace-style = disabled

# Compose Multiplatform UI in the shared source-onboarding module. `@Composable` functions are
# PascalCase by Compose convention, which ktlint's function-naming rule flags; this is the rule's
# own opt-out rather than a per-function @Suppress on every screen.
[feature/source-ui/**/*.kt]
ktlint_function_naming_ignore_when_annotated_with = Composable

# Compose Multiplatform writes its generated `Res` resource accessors into build/generated and
# registers that directory as a Kotlin source root, so ktlint's per-source-set tasks pick them up.
# They are machine-generated and not ours to format.
[**/build/generated/**/*.kt]
ktlint = disabled
