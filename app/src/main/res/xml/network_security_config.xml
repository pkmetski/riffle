<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext traffic (HTTP) is permitted globally because users connect to self-hosted
  Audiobookshelf servers that may not have TLS configured. The app shows a one-time
  warning before allowing an insecure connection. User-installed CA certificates are
  intentionally excluded to reduce the MitM surface.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      kaikki.org serves Let's Encrypt certificates signed by the YE2 intermediate, which chains to
      ISRG Root X2 (ECDSA). Android 7.1.1 (API 25) only ships ISRG Root X1 in its system trust
      store, so we bundle Root X2 here to allow dictionary pack downloads on older devices.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">kaikki.org</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </domain-config>
</network-security-config>
