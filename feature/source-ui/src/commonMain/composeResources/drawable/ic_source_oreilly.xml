<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline fallback / monogram for the O'Reilly (learning.oreilly.com) source icon.
  Shown when Coil has not yet fetched the remote favicon.
  Circular background matches the actual favicon silhouette so the crossfade is imperceptible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">
    <!-- Red circle background — matches the circular shape of the actual favicon -->
    <path
        android:pathData="M20,0 A20,20 0 1 0 20,40 A20,20 0 1 0 20,0 Z"
        android:fillColor="#D3002D" />
    <!-- White ring "O" -->
    <path
        android:pathData="M20,9 A11,11 0 1 0 20,31 A11,11 0 1 0 20,9 Z M20,15 A5,5 0 1 1 20,25 A5,5 0 1 1 20,15 Z"
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd" />
</vector>
